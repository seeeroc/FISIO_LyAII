PARSER_BEGIN(FisioParser)
package fisio;

import java.util.ArrayList;
import java.util.List;
import fisio.analysis.ErrorSintactico;
import fisio.ast.NodoPrograma;

public class FisioParser {
    private List<ErrorSintactico> listaErrores = new ArrayList<>();

    public List<ErrorSintactico> errores() {
        return this.listaErrores;
    }
}
PARSER_END(FisioParser)

/* ==========================================
   1. CARACTERES IGNORADOS (Espacios y saltos)
   ========================================== */
SKIP : {
    " "
  | "\t"
  | "\n"
  | "\r"
}

/* ==========================================
   2. COMENTARIOS
   ========================================== */
SKIP : {
    // Comentario de línea
    < "//" (~["\n", "\r"])* ("\n" | "\r" | "\r\n")? >
    // Comentario de bloque
  | < "/*" (~["*"])* "*" (~["/"] (~["*"])* "*")* "/" >
}

/* ==========================================
   3. PALABRAS RESERVADAS (PR)
   ========================================== */
TOKEN : {
    < FN: "fn" >
  | < LET: "let" >
  | < MUT: "mut" >
  | < IF: "if" >
  | < ELSE: "else" >
  | < WHILE: "while" >
  | < FOR: "for" >
  | < IN: "in" >
  | < LOOP: "loop" >
  | < MATCH: "match" >
  | < RETURN: "return" >
  | < STRUCT: "struct" >
  | < ENUM: "enum" >
  | < IMPL: "impl" >
  | < TRAIT: "trait" >
  | < PUB: "pub" >
  | < USE: "use" >
  | < TRUE: "true" >
  | < FALSE: "false" >
  | < TYPE: "type" >
  | < CONST: "const" >
  | < STATIC: "static" >
  | < AS: "as" >
}

/* ==========================================
   4. OPERADORES MATEMÁTICOS (OPM) Y RELACIONALES (OPR)
   ========================================== */
TOKEN : {
    < MAS: "+" >
  | < MENOS: "-" >
  | < MULT: "*" >
  | < DIV: "/" >
  | < MOD: "%" >
  | < IGUAL_QUE: "==" >
  | < DIFERENTE: "!=" >
  | < MENOR_QUE: "<" >
  | < MAYOR_QUE: ">" >
  | < MENOR_IGUAL: "<=" >
  | < MAYOR_IGUAL: ">=" >
}

/* ==========================================
   5. SIGNOS (SIG)
   ========================================== */
TOKEN : {
    < PAREN_IZQ: "(" >
  | < PAREN_DER: ")" >
  | < CORCHETE_IZQ: "[" >
  | < CORCHETE_DER: "]" >
  | < LLAVE_IZQ: "{" >
  | < LLAVE_DER: "}" >
  | < COMA: "," >
  | < PUNTO: "." >
  | < PUNTO_COMA: ";" >
  | < DOS_PUNTOS: ":" >
  | < ASIGNACION: "=" >
  | < NEGACION: "!" >
  | < AMPERSAND: "&" >
  | < PIPE: "|" >
  | < FLECHA: "->" >
  | < FLECHA_GRUESA: "=>" >
  | < DOBLE_DOS_PUNTOS: "::" >
  | < AND: "&&" >
  | < OR: "||" >
}

/* ==========================================
   6. EXPRESIONES COMPLEJAS (ID, NUM, STRING)
   ========================================== */
TOKEN : {
    < ID: ["a"-"z", "A"-"Z", "_"] ( ["a"-"z", "A"-"Z", "_", "0"-"9"] )* >
  | < NUM: (["0"-"9"])+ ("." (["0"-"9"])+)? >
  | < STRING: "\"" (~["\""])* "\"" >
}

/* ==========================================
   7. MANEJO DE ERRORES LÉXICOS
   ========================================== */
// Cualquier carácter que no coincida con los tokens anteriores caerá aquí
TOKEN : {
    < ERROR: ~[] >
}

/* ==========================================
   8. REGLAS SINTÁCTICAS (TEMPORAL)
   ========================================== */

NodoPrograma Programa() :
{
}
{
    ( <ANY_TOKEN_OR_JUST_SKIP: ~[]> )* <EOF>
    {
        // Pasamos los argumentos requeridos por el record de tu companero
        return new NodoPrograma(0, 0, new ArrayList<>()); 
    }
}